# Copy to .env. Blank channels are disabled; do not enter placeholder credentials.
# Email requires a real recipient, SMTP server, username and app password.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Discord / Slack webhook URLs; leave blank to disable.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

ALERT_THRESHOLD=60
# CSV or a JSON array is accepted for these lists.
DEFAULT_PREFERRED_TECH=python,javascript,typescript,react,node.js,sql,docker,aws,azure,git,c#,java
DEFAULT_PREFERRED_LOCATIONS=helsinki,espoo,vantaa,tampere,turku,oulu,bengaluru,bangalore

# Bounded concurrent source refreshes; a stalled source cannot block forever.
SOURCE_TIMEOUT_SECONDS=120
SOURCE_CONCURRENCY=3
# Restricted adapter is disabled by default. Only enable with permitted access.
ENABLE_LINKEDIN=false

# Optional donation/support URL; hidden when blank.
SUPPORT_URL=
